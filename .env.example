# StatGap AI — Frontend (Vite) Environment Variables
# =====================================================
# Copy this file to .env and fill in values for local development.
# On Vercel: set these in Project Settings → Environment Variables.
# NEVER commit real values to source control.

# Required for production (Vercel):
# The public HTTPS URL of your deployed Render backend.
# Example: https://statgap-ai-backend.onrender.com
# Leave unset locally to fall back to http://localhost:8001 (development only).
VITE_API_BASE_URL=

# Optional: pre-fills the demo password on the login page for evaluation demos.
# This value is embedded in the JS bundle at build time — do NOT put real secrets here.
# Defaults to DemoPassword@123 when unset.
VITE_DEMO_PASSWORD=
