# StatGap AI — Backend (FastAPI) Environment Variables
# ======================================================
# Copy this file to backend/.env for local development.
# On Render: set these in the service Environment tab.
# NEVER commit real values to source control.

# ── Application ──────────────────────────────────────
# Options: development | production | test
ENVIRONMENT=production

# ── Database ─────────────────────────────────────────
# Production: PostgreSQL connection string (Render PostgreSQL or external service with pgvector).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Render provides this as DATABASE_URL automatically when a PostgreSQL database is attached.
# Important: If Render provides a postgres:// URL, change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@host:5432/statgapai

# ── JWT Authentication ────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters. Application WILL NOT START without a valid secret in production.
JWT_SECRET_KEY=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Seed Password ─────────────────────────────────────
# Password used when running seed_data.py to create demo users.
# Not used at runtime after seeding.
SEED_DEMO_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set to your exact Vercel URL (no trailing slash).
# Example: https://statgap-ai.vercel.app,https://statgap-ai-custom.vercel.app
# Development origins are safe to include alongside production origins.
CORS_ORIGINS=https://YOUR_APP.vercel.app,http://localhost:5173,http://localhost:3000

# ── Gemini AI / RAG ───────────────────────────────────
# Required for production AI features (gap explanations, RAG, embeddings).
# Obtain from: https://aistudio.google.com/app/apikey
# If unset, the system falls back to MockEmbeddingProvider and MockLLMProvider
# (functional but produces deterministic demo responses instead of real AI output).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.50

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ── iGOT Integration ─────────────────────────────────
# Options: mock | authorized
# Use mock for prototype/demo deployments.
IGOT_MODE=mock
# Required only when IGOT_MODE=authorized:
# IGOT_API_BASE_URL=https://api.igotkarmayogi.gov.in
# IGOT_CLIENT_ID=
# IGOT_CLIENT_SECRET=

# ── NSSTA / TPAC Integration ─────────────────────────
# Options: mock | live
NSSTA_MODE=mock
# NSSTA_API_BASE_URL=
# NSSTA_API_KEY=
TPAC_MODE=catalogue
